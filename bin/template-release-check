#!/bin/bash

set -euo pipefail

die() {
    printf '%s\n' "$1" >&2
    exit 1
}

if [ "$#" -gt 1 ]; then
    die 'Usage: bin/template-release-check [template-root]'
fi

if [ "$#" -eq 1 ]; then
    root=$(cd "$1" 2>/dev/null && pwd -P) || die "Template root missing: $1"
else
    root=$(git rev-parse --show-toplevel 2>/dev/null) || \
        die 'Current directory is not a Git repository.'
fi

version_file="$root/VERSION"
changelog_file="$root/CHANGELOG.md"
manifest_file="$root/template-manifest.tsv"

[ -f "$version_file" ] || die "VERSION missing: $version_file"
[ -f "$changelog_file" ] || die "CHANGELOG.md missing: $changelog_file"
[ -f "$manifest_file" ] || die "Manifest missing: $manifest_file"

# Every repository file must carry an explicit ownership strategy so that
# agents and tooling never have to guess whether a file belongs to the
# template or to a consumer.
declare -A manifest_paths=()
while IFS=$'\t' read -r strategy path || [ -n "${strategy:-}" ]; do
    case "$strategy" in
        '' | '#'*) continue ;;
    esac
    manifest_paths[$path]=1
done < "$manifest_file"

missing_paths=()
while IFS= read -r -d '' repo_path; do
    [ -n "${manifest_paths[$repo_path]+set}" ] || missing_paths+=("$repo_path")
done < <(git -C "$root" ls-files -z --cached --others --exclude-standard 2>/dev/null | sort -zu)

if [ "${#missing_paths[@]}" -gt 0 ]; then
    printf 'Manifest entry missing: %s\n' "${missing_paths[@]}" >&2
    die 'Classify every repository file in template-manifest.tsv.'
fi

version=$(<"$version_file")
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || \
    die "VERSION must match major.minor.patch: $version"

changelog_version=$(awk '
    match($0, /^## \[([0-9]+\.[0-9]+\.[0-9]+)\]/, match_data) {
        print match_data[1]
        exit
    }
' "$changelog_file")
[ "$changelog_version" = "$version" ] || \
    die "CHANGELOG version $changelog_version does not match VERSION $version."

version_commit=$(git -C "$root" log -1 --format=%H -- VERSION 2>/dev/null) || true
[ -n "$version_commit" ] || die 'VERSION is not yet versioned in Git.'

changed_paths=$(
    {
        git -C "$root" diff --name-only "$version_commit..HEAD" --
        git -C "$root" diff --name-only HEAD --
        git -C "$root" ls-files --others --exclude-standard
    } | sort -u
)
version_changed=0
changelog_changed=0
template_change=

while IFS= read -r changed_path; do
    [ -n "$changed_path" ] || continue
    case "$changed_path" in
        VERSION) version_changed=1; continue ;;
        CHANGELOG.md) changelog_changed=1; continue ;;
    esac

    while IFS=$'\t' read -r strategy path || [ -n "${strategy:-}" ]; do
        [ "$path" = "$changed_path" ] || continue
        if [ "$strategy" = template-owned ] || [ "$strategy" = template-internal ] \
            || [ "$strategy" = template-retired ]; then
            template_change=$changed_path
        fi
        break
    done < "$manifest_file"

done <<< "$changed_paths"

if [ -n "$template_change" ] && { [ "$version_changed" -ne 1 ] || [ "$changelog_changed" -ne 1 ]; }; then
    die "Release version missing: $template_change changed since the last VERSION change."
fi

if [ "$version_changed" -ne "$changelog_changed" ]; then
    die 'VERSION and CHANGELOG.md must be changed together.'
fi

printf 'Template release %s is consistent.\n' "$version"
