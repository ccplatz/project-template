#!/bin/bash
set -euo pipefail

script_dir=$(dirname "$(readlink -f "$0")")
# shellcheck source=container-lib.sh
# shellcheck disable=SC1091
source "$script_dir/container-lib.sh"
# shellcheck source=project-config.sh
# shellcheck disable=SC1091
source "$script_dir/project-config.sh"

root_path=${CONTAINER_TEST_ROOT:-$(dirname "$script_dir")}
cd "$root_path" || exit 1
root_path=$PWD

build_flag=0
attach_short=''
logs_follow=0
logs_service=''

usage_error() {
    usage >&2
    exit 1
}

action=${1:-}
case "$action" in
    --help|-h) usage; exit 0 ;;
    start|stop|restart|attach|status|ps|logs) ;;
    *) usage_error ;;
esac
shift

case "$action" in
    start|restart)
        case "${1:-}" in
            --build) build_flag=1; shift ;;
            '') build_flag=0 ;;
            *) usage_error ;;
        esac
        [ "$#" -eq 0 ] || usage_error
        ;;
    stop|status|ps)
        [ "$#" -eq 0 ] || usage_error
        ;;
    attach)
        [ "$#" -eq 1 ] || usage_error
        attach_short=$1
        ;;
    logs)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                -f|--follow) logs_follow=1; shift ;;
                -*) usage_error ;;
                *) [ -z "$logs_service" ] || usage_error; logs_service=$1; shift ;;
            esac
        done
        ;;
esac

if [ ! -f "$ENV_FILE" ]; then
    printf 'Die Datei %s existiert nicht.\n' "$ENV_FILE" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "$ENV_FILE"

load_project_config "$root_path"

if ! validate_environment "${ENVIRONMENT:-}"; then
    exit 1
fi
COMPOSE_FILE=$(resolve_compose_file "$ENVIRONMENT")
COMPOSE_PROJECT_NAME=$PROJECT_NAME
export COMPOSE_FILE HOSTNAME COMPOSE_PROJECT_NAME

do_start() {
    local nets=()
    mapfile -t nets < <(list_external_networks "${EXTERNAL_NETWORKS:-}")
    local net
    if [ "${#nets[@]}" -gt 0 ]; then
        for net in "${nets[@]}"; do
            if ! network_exists "$net"; then
                printf 'Erstelle Netzwerk: %s\n' "$net"
                run_docker network create "$net" >/dev/null
            else
                printf 'Netzwerk %s existiert bereits.\n' "$net"
            fi
        done
    fi
    printf 'Starte %s-Umgebung ...\n' "$ENVIRONMENT"
    if [ "$build_flag" -eq 1 ]; then
        run_compose -f "$COMPOSE_FILE" up --build -d --remove-orphans
    else
        run_compose -f "$COMPOSE_FILE" up -d --remove-orphans
    fi
}

do_stop() {
    printf 'Stoppe Container ...\n'
    run_compose -f "$COMPOSE_FILE" down --remove-orphans
    local nets=()
    mapfile -t nets < <(list_external_networks "${EXTERNAL_NETWORKS:-}")
    [ "${#nets[@]}" -gt 0 ] || return 0
    local net failed=0
    for net in "${nets[@]}"; do
        if network_exists "$net"; then
            if ! network_has_containers "$net"; then
                printf 'Entferne Netzwerk %s ...\n' "$net"
                if ! run_docker network rm "$net" >/dev/null 2>&1; then
                    printf 'Warnung: Netzwerk %s konnte nicht entfernt werden.\n' "$net" >&2
                    failed=1
                fi
            else
                printf 'Netzwerk %s wird weiter verwendet, bleibt bestehen.\n' "$net"
            fi
        fi
    done
    [ "$failed" -eq 0 ] || return 1
}

do_restart() {
    do_stop
    do_start
}

do_attach() {
    local short=$1 name shell_type=/bin/bash
    name=$(container_full_name "$short")
    if ! container_is_running "$name"; then
        printf 'Container %s läuft nicht.\n' "$name" >&2
        return 1
    fi
    if ! shell_available "$name" "$shell_type"; then
        shell_type=/bin/sh
    fi
    printf 'Verbinde mit Container %s ...\n' "$name"
    run_docker exec -it "$name" "$shell_type"
}

do_status() {
    printf 'ENVIRONMENT: %s\n' "$ENVIRONMENT"
    printf 'Compose-Datei: %s\n' "$COMPOSE_FILE"
    printf 'Laufende Services:\n'
    run_compose -f "$COMPOSE_FILE" ps 2>/dev/null || printf '  (nicht verfügbar)\n'
    local nets=()
    mapfile -t nets < <(list_external_networks "${EXTERNAL_NETWORKS:-}")
    if [ "${#nets[@]}" -gt 0 ]; then
        printf 'Externe Netzwerke:\n'
        local net count
        for net in "${nets[@]}"; do
            if network_exists "$net"; then
                count=$(run_docker network inspect "$net" \
                    --format '{{len .Containers}}' 2>/dev/null || printf 0)
                printf '  %s: %s Container\n' "$net" "${count:-0}"
            else
                printf '  %s: nicht vorhanden\n' "$net"
            fi
        done
    fi
}

do_ps() {
    run_docker ps --filter "label=com.docker.compose.project=$PROJECT_NAME" \
        --format 'table {{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}\t{{.RunningFor}}\t{{.Ports}}\t{{.Networks}}'
}

do_logs() {
    local service=$1 follow=$2
    if [ "$follow" -eq 1 ]; then
        # shellcheck disable=SC2086
        run_compose -f "$COMPOSE_FILE" logs -f --tail=200 ${service:+"$service"}
    else
        # shellcheck disable=SC2086
        run_compose -f "$COMPOSE_FILE" logs --tail=200 ${service:+"$service"}
    fi
}

case "$action" in
    start) do_start ;;
    stop) do_stop ;;
    restart) do_restart ;;
    attach) do_attach "$attach_short" ;;
    status) do_status ;;
    ps) do_ps ;;
    logs) do_logs "$logs_service" "$logs_follow" ;;
esac
