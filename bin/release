#!/bin/bash
# bin/release — lege eine neue Template-Version an.
#
# Verwendung:
#   bin/release [patch|minor|major]   # Standard: patch
#
# Voraussetzungen:
#   - sauberes Arbeitsverzeichnis (alles committet)
#   - CHANGELOG.md hat an der Spitze eine "## [Unreleased]"-Sektion
#
# Erstellt: VERSION-Bump, CHANGELOG-Header, Version-Sync in
# tests/bin/template_sync_test.sh, Commit ("release: bump template to X.Y.Z"),
# Konsistenzprüfung mit bin/template-release-check (bei Fehler Rollback des
# Commits) und anschließend annotierten Tag vX.Y.Z.

set -euo pipefail

die() {
    printf 'release: %s\n' "$1" >&2
    exit 1
}

bump_type=${1:-patch}
root=$(git rev-parse --show-toplevel 2>/dev/null) || \
    die 'Aktuelles Verzeichnis ist kein Git-Repository.'

[ -f "$root/VERSION" ] || die "VERSION fehlt: $root/VERSION"
[ -f "$root/CHANGELOG.md" ] || die "CHANGELOG.md fehlt: $root/CHANGELOG.md"

old_version=$(<"$root/VERSION")
[[ "$old_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || \
    die "VERSION muss major.minor.patch entsprechen: $old_version"

case "$bump_type" in
    patch|minor|major) ;;
    *) die "Ungültiger Bump-Typ: $bump_type (patch|minor|major)" ;;
esac

tree_status=$(git -C "$root" status --porcelain --untracked-files=normal 2>/dev/null) || \
    die 'Der Zustand des Arbeitsverzeichnisses konnte nicht geprüft werden.'
[ -z "$tree_status" ] || \
    die 'Arbeitsverzeichnis ist nicht sauber; committe oder stashe zuerst.'

grep -qx '## \[Unreleased\]' "$root/CHANGELOG.md" || \
    die 'CHANGELOG.md braucht eine "## [Unreleased]"-Sektion an der Spitze.'

new_version=$(awk -F. -v part="$bump_type" '
    BEGIN { OFS = "." }
    {
        if (part == "patch") $3++
        else if (part == "minor") { $2++; $3 = 0 }
        else { $1++; $2 = 0; $3 = 0 }
        print
    }
' <<< "$old_version")

date_stamp=$(date +%F)
awk -v old='## [Unreleased]' -v header="## [$new_version] - $date_stamp" '
    !replaced && $0 == old { print header; replaced = 1; next }
    { print }
' "$root/CHANGELOG.md" > "$root/CHANGELOG.md.tmp"
mv "$root/CHANGELOG.md.tmp" "$root/CHANGELOG.md"

printf '%s\n' "$new_version" > "$root/VERSION"

escaped_old=${old_version//./\\.}
[ -f "$root/tests/bin/template_sync_test.sh" ] || \
    die 'tests/bin/template_sync_test.sh fehlt für die Version-Synchronisation.'
# Nur template_sync_test.sh assertiert die echte Repo-VERSION; die Fixtures in
# release_test.sh bleiben absolut und werden deshalb nicht synchronisiert.
sed -i "s/$escaped_old/$new_version/g" "$root/tests/bin/template_sync_test.sh"

git -C "$root" add VERSION CHANGELOG.md tests/bin/template_sync_test.sh
git -C "$root" commit -q -m "release: bump template to $new_version"

if ! "$root/bin/template-release-check" "$root"; then
    git -C "$root" reset --hard HEAD~1 >/dev/null
    die 'Konsistenzprüfung fehlgeschlagen; Release-Commit wurde zurückgesetzt.'
fi

git -C "$root" tag -a "v$new_version" -m "Template $new_version"

printf 'Release %s erstellt (Tag v%s). Push mit: git push --tags\n' \
    "$new_version" "$new_version"
