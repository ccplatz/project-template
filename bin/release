#!/bin/bash
# bin/release — create a new template version.
#
# Usage:
#   bin/release [patch|minor|major]   # default: patch
#
# Requirements:
#   - clean working directory (everything committed)
#   - CHANGELOG.md has a "## [Unreleased]" section at the top
#
# Creates: VERSION bump, CHANGELOG header, version sync in
# tests/bin/template_sync_test.sh, commit ("release: bump template to X.Y.Z"),
# consistency check with bin/template-release-check (rollback of the commit on
# failure) and afterwards an annotated tag vX.Y.Z.

set -euo pipefail

die() {
    printf 'release: %s\n' "$1" >&2
    exit 1
}

bump_type=${1:-patch}
root=$(git rev-parse --show-toplevel 2>/dev/null) || \
    die 'Current directory is not a Git repository.'

[ -f "$root/VERSION" ] || die "VERSION missing: $root/VERSION"
[ -f "$root/CHANGELOG.md" ] || die "CHANGELOG.md missing: $root/CHANGELOG.md"

old_version=$(<"$root/VERSION")
[[ "$old_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || \
    die "VERSION must match major.minor.patch: $old_version"

case "$bump_type" in
    patch|minor|major) ;;
    *) die "Invalid bump type: $bump_type (patch|minor|major)" ;;
esac

tree_status=$(git -C "$root" status --porcelain --untracked-files=normal 2>/dev/null) || \
    die 'Could not check the working directory state.'
[ -z "$tree_status" ] || \
    die 'Working directory is not clean; commit or stash first.'

grep -qx '## \[Unreleased\]' "$root/CHANGELOG.md" || \
    die 'CHANGELOG.md needs a "## [Unreleased]" section at the top.'

new_version=$(awk -F. -v part="$bump_type" '
    BEGIN { OFS = "." }
    {
        if (part == "patch") $3++
        else if (part == "minor") { $2++; $3 = 0 }
        else { $1++; $2 = 0; $3 = 0 }
        print
    }
' <<< "$old_version")

date_stamp=$(date +%F)
awk -v old='## [Unreleased]' -v header="## [$new_version] - $date_stamp" '
    !replaced && $0 == old { print header; replaced = 1; next }
    { print }
' "$root/CHANGELOG.md" > "$root/CHANGELOG.md.tmp"
mv "$root/CHANGELOG.md.tmp" "$root/CHANGELOG.md"

printf '%s\n' "$new_version" > "$root/VERSION"

escaped_old=${old_version//./\\.}
[ -f "$root/tests/bin/template_sync_test.sh" ] || \
    die 'tests/bin/template_sync_test.sh missing for the version sync.'
# Only template_sync_test.sh asserts the real repo VERSION; the fixtures in
# release_test.sh stay absolute and are therefore not synchronized.
sed -i "s/$escaped_old/$new_version/g" "$root/tests/bin/template_sync_test.sh"

git -C "$root" add VERSION CHANGELOG.md tests/bin/template_sync_test.sh
git -C "$root" commit -q -m "release: bump template to $new_version"

if ! "$root/bin/template-release-check" "$root"; then
    git -C "$root" reset --hard HEAD~1 >/dev/null
    die 'Consistency check failed; the release commit was rolled back.'
fi

git -C "$root" tag -a "v$new_version" -m "Template $new_version"

printf 'Release %s created (tag v%s). Push with: git push --tags\n' \
    "$new_version" "$new_version"
