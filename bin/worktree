#!/bin/bash

set -euo pipefail

script_root=$(cd "$(dirname "$0")/.." && pwd)
export WORKTREE_TEST_ROOT=${WORKTREE_TEST_ROOT:-$script_root}
worktree_root=${WORKTREE_TEST_ROOT:-$script_root}

usage() {
    cat <<'EOF'
bin/worktree — Worktree-Verwaltung für das Projekt

Verwendung:
  bin/worktree create <name> [--existing]
  bin/worktree switch <name> [--fresh]
  bin/worktree start [--fresh]
  bin/worktree stop
  bin/worktree status

Befehle:
  create <name>       Neuen Worktree anlegen und bootstrappen
    --existing        Branch <name> existiert bereits, nicht von main abzweigen

  switch <name>       Aktiven Worktree wechseln
    --fresh           Datenbank zurücksetzen (migrate:fresh --seed)

  start               Aktiven Worktree starten
    --fresh           Datenbank nach dem Start zurücksetzen

  stop                Aktiven Worktree stoppen

  status              Aktiven Worktree anzeigen (Name, Pfad, Branch, Status)

Optionen:
  --help, -h          Diese Hilfe anzeigen
EOF
}

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
    usage
    exit 0
fi

# shellcheck source=bin/worktree-lib.sh
# shellcheck disable=SC2154
source "$script_root/bin/worktree-lib.sh"

run_git() {
    git -C "$worktree_root" "$@"
}

command_failed() {
    printf 'Fehler bei Schritt: %s\n' "$1" >&2
    return 1
}

run_create_step() {
    local label=$1
    shift
    if ! "$@"; then
        command_failed "$label"
    fi
}

run_bootstrap_command() {
    local target=$1
    local build_context=$2
    local sail_bin=$3
    local mysql_init_script=$4
    shift 4

    (
        cd "$target" || exit 1
        COMPOSE_PROJECT_NAME="$PROJECT_NAME" SAIL_SOURCE_PATH="$target" \
            SAIL_BUILD_CONTEXT="$build_context" SAIL_BUILD_DOCKERFILE=Dockerfile \
            SAIL_MYSQL_INIT_SCRIPT="$mysql_init_script" SAIL_BIN="$sail_bin" \
            "$sail_bin" "$@"
    )
}

bootstrap_worktree() {
    local target=$1
    local main_sail=$worktree_root/vendor/bin/sail
    local build_context=$worktree_root/vendor/laravel/sail/runtimes/8.5
    local mysql_init_script=$worktree_root/vendor/laravel/sail/database/mysql/create-testing-database.sh

    if [ ! -f "$target/.env" ] && [ -f "$target/.env.template" ]; then
        run_create_step 'env kopieren' cp "$target/.env.template" "$target/.env" || return 1
    fi

    local prior_path=''
    local prior_name=''
    if prior_name=$(read_active_worktree 2>/dev/null); then
        prior_path=$(resolve_worktree "$prior_name" 2>/dev/null) || prior_path=''
    fi

    bootstrap_rollback() {
        local rollback_status=0

        if ! run_bootstrap_command "$target" "$build_context" "$main_sail" \
            "$mysql_init_script" down --remove-orphans; then
            printf 'Rollback fehlgeschlagen: Ziel-Stack konnte nicht gestoppt werden.\n' >&2
            rollback_status=1
        fi
        if [ -n "$prior_path" ] && ! start_for_worktree "$prior_path"; then
            printf 'Rollback fehlgeschlagen: vorheriger Worktree konnte nicht gestartet werden.\n' >&2
            rollback_status=1
        fi
        return "$rollback_status"
    }

    run_create_step 'Stack starten' run_bootstrap_command "$target" "$build_context" \
        "$main_sail" "$mysql_init_script" up -d --remove-orphans || {
        bootstrap_rollback
        return 1
    }
    run_create_step 'Composer-Abhängigkeiten installieren' run_bootstrap_command "$target" \
        "$build_context" "$main_sail" "$mysql_init_script" composer install || {
        bootstrap_rollback
        return 1
    }

    local target_sail=$target/vendor/bin/sail
    if [ ! -x "$target_sail" ]; then
        command_failed 'Sail nach Composer-Installation nicht gefunden'
        bootstrap_rollback
        return 1
    fi

    run_create_step 'Node-Abhängigkeiten installieren' run_bootstrap_command "$target" '' \
        "$target_sail" '' npm install || {
        bootstrap_rollback
        return 1
    }
    if ! grep -Eq '^APP_KEY=.+$' "$target/.env" 2>/dev/null; then
        run_create_step 'Anwendungsschlüssel erzeugen' run_bootstrap_command "$target" '' \
            "$target_sail" '' artisan key:generate || {
            bootstrap_rollback
            return 1
        }
    fi
}

create_worktree() {
    local name=$1
    local existing=${2:-0}
    local target
    validate_worktree_name "$name" || return 1
    ensure_main_sail_setup || return 1
    port_is_available 8080 || die 'Port 8080 ist bereits belegt' || return 1
    target=$(worktree_path "$name")

    if [ -e "$target" ]; then
        die "worktree already exists: $target"
        return 1
    fi

    if [ "$existing" -eq 1 ]; then
        validate_existing_branch "$name" || return 1
        run_git worktree add "$target" "$name" || return 1
    else
        run_git worktree add -b "$name" "$target" main || return 1
    fi

    bootstrap_worktree "$target" || return 1
    write_active_worktree "$name"
}

start_active() {
    local fresh=${1:-0}
    local name
    local path
    name=$(read_active_worktree) || return 1
    path=$(resolve_worktree "$name") || return 1

    start_for_worktree "$path" || return 1
    if [ "$fresh" -eq 1 ]; then
        run_fresh "$path" || return 1
    fi
    write_active_worktree "$name"
}

switch_worktree() {
    local name=$1
    local fresh=${2:-0}
    local target
    local prior_name=''
    local prior_path=''
    local prior_running=0
    local target_running=0
    local stop_path=''

    target=$(resolve_worktree "$name") || return 1
    validate_worktree_prerequisites "$target" || return 1
    if prior_name=$(read_active_worktree 2>/dev/null); then
        prior_path=$(resolve_worktree "$prior_name" 2>/dev/null) || prior_path=''
    fi

    if [ -n "$prior_path" ] && stack_is_running_for_worktree "$prior_path"; then
        prior_running=1
    fi
    if stack_is_running_for_worktree "$target"; then
        target_running=1
    fi
    if [ "$target_running" -eq 1 ]; then
        stop_path=$target
    elif [ "$prior_running" -eq 1 ]; then
        stop_path=$prior_path
    fi
    if [ -z "$stop_path" ]; then
        port_is_available 8080 || die 'Port 8080 ist bereits belegt' || return 1
    fi

    if [ -n "$stop_path" ]; then
        stop_for_worktree "$stop_path" || return 1
    fi

    if ! start_for_worktree "$target"; then
        printf 'Start des Worktrees "%s" fehlgeschlagen.\n' "$name" >&2
        if [ -n "$prior_path" ]; then
            start_for_worktree "$prior_path" || true
        fi
        return 1
    fi

    if [ "$fresh" -eq 1 ] && ! run_fresh "$target"; then
        printf 'Ziel-Stack läuft, aber der Datenbank-Reset wurde nicht abgeschlossen.\n' >&2
        return 1
    fi
    write_active_worktree "$name"
}

show_status() {
    local name
    local path
    local branch
    name=$(read_active_worktree) || return 1
    path=$(resolve_worktree "$name") || return 1
    branch=$(git -C "$path" branch --show-current)
    printf 'active: %s\npath: %s\nbranch: %s\nstatus: ' "$name" "$path" "$branch"
    if stack_is_running_for_worktree "$path"; then
        printf 'running\n'
    else
        printf 'stopped\n'
    fi
}

if [ "$#" -eq 0 ]; then
    usage >&2
    exit 1
fi

command=$1
shift
case "$command" in
    create)
        if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
            usage >&2
            exit 1
        fi
        case "${2:-}" in
            '') create_worktree "$1" 0 ;;
            --existing) create_worktree "$1" 1 ;;
            *) usage >&2; exit 1 ;;
        esac
        ;;
    switch)
        if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
            usage >&2
            exit 1
        fi
        case "${2:-}" in
            '') switch_worktree "$1" 0 ;;
            --fresh) switch_worktree "$1" 1 ;;
            *) usage >&2; exit 1 ;;
        esac
        ;;
    start)
        if [ "$#" -eq 0 ]; then
            start_active 0
        elif [ "$#" -eq 1 ] && [ "$1" = --fresh ]; then
            start_active 1
        else
            usage >&2
            exit 1
        fi
        ;;
    stop)
        if [ "$#" -ne 0 ]; then
            usage >&2
            exit 1
        fi
        stop_for_worktree "$(active_worktree)"
        ;;
    status)
        if [ "$#" -ne 0 ]; then
            usage >&2
            exit 1
        fi
        show_status
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
