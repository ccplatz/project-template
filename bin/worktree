#!/bin/bash

set -euo pipefail

script_root=$(cd "$(dirname "$0")/.." && pwd)
export WORKTREE_TEST_ROOT=${WORKTREE_TEST_ROOT:-$script_root}
worktree_root=${WORKTREE_TEST_ROOT:-$script_root}

usage() {
    cat <<'EOF'
bin/worktree — Worktree-Verwaltung für das Projekt

Verwendung:
  bin/worktree create <name> [--existing]
  bin/worktree bootstrap <name>
  bin/worktree start [<name>] [--fresh]
  bin/worktree stop [<name>]
  bin/worktree switch <name> [--fresh]
  bin/worktree status [<name>]
  bin/worktree status --all
  bin/worktree prune

Befehle:
  create <name>       Neuen Worktree anlegen und bootstrappen
    --existing        Branch <name> existiert bereits, nicht von main abzweigen

  bootstrap <name>    Worktree-Abhängigkeiten installieren und vorbereiten

  start [<name>]      Benannten oder aktiven Worktree starten
    --fresh           Datenbank nach dem Start zurücksetzen

  stop [<name>]       Benannten oder aktiven Worktree stoppen

  switch <name>       Worktree auswählen und starten, andere Stacks bleiben aktiv
    --fresh           Datenbank zurücksetzen (migrate:fresh --seed)

  status [<name>]     Einen Worktree mit Projekt, URL, Ports und Status anzeigen
    --all             Alle Worktrees und verwaiste Zustände anzeigen

  prune               Verwaiste Zustandsdateien entfernen

Optionen:
  --help, -h          Diese Hilfe anzeigen
EOF
}

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
    usage
    exit 0
fi

# shellcheck source=bin/worktree-lib.sh
# shellcheck disable=SC2154
source "$script_root/bin/worktree-lib.sh"

run_git() {
    git -C "$worktree_root" "$@"
}

command_failed() {
    printf 'Fehler bei Schritt: %s\n' "$1" >&2
    return 1
}

run_create_step() {
    local label=$1
    shift
    if ! "$@"; then
        command_failed "$label"
    fi
}

run_bootstrap_command() {
    local name=$1
    local target=$2
    local build_context=$3
    local sail_bin=$4
    local mysql_init_script=$5
    local build_dockerfile=Dockerfile
    shift 5

    run_worktree_sail "$name" "$target" "$sail_bin" "$mysql_init_script" \
        "$build_context" "$build_dockerfile" "$@"
}

bootstrap_worktree() {
    local name=$1
    local target=$2
    local main_sail=$worktree_root/vendor/bin/sail
    local build_context=$worktree_root/vendor/laravel/sail/runtimes/8.5
    local mysql_init_script=$worktree_root/vendor/laravel/sail/database/mysql/create-testing-database.sh

    if [ ! -f "$target/.env" ] && [ -f "$target/.env.template" ]; then
        run_create_step 'env kopieren' cp "$target/.env.template" "$target/.env" || return 1
    fi
    validate_worktree_prerequisites "$target" || return 1
    ensure_worktree_state "$name" "$target" || return 1
    ensure_main_sail_setup || return 1

    if ! run_create_step 'Stack starten' run_bootstrap_command "$name" "$target" "$build_context" \
        "$main_sail" "$mysql_init_script" up -d --remove-orphans; then
        cleanup_failed_target_start "$name" "$target" "$main_sail" "$mysql_init_script" || true
        return 1
    fi

    if ! composer_artifacts_valid "$target"; then
        run_create_step 'Composer-Abhängigkeiten installieren' run_bootstrap_command "$name" "$target" \
            "$build_context" "$main_sail" "$mysql_init_script" composer install || return 1
    fi
    if ! composer_artifacts_valid "$target"; then
        command_failed 'Sail nach Composer-Installation nicht gefunden'
        return 1
    fi

    local target_sail=$target/vendor/bin/sail
    if ! npm_artifacts_valid "$target" || ! application_key_is_set "$target"; then
        if [ ! -x "$target_sail" ]; then
            command_failed 'Sail nach Composer-Installation nicht gefunden'
            return 1
        fi
    fi
    if ! npm_artifacts_valid "$target"; then
        run_create_step 'Node-Abhängigkeiten installieren' run_bootstrap_command "$name" "$target" '' \
            "$target_sail" '' npm install || return 1
    fi
    if ! application_key_is_set "$target"; then
        run_create_step 'Anwendungsschlüssel erzeugen' run_bootstrap_command "$name" "$target" '' \
            "$target_sail" '' artisan key:generate || return 1
    fi
}

create_worktree() {
    local name=$1
    local existing=${2:-0}
    local target
    validate_worktree_name "$name" || return 1
    ensure_main_sail_setup || return 1
    target=$(worktree_path "$name")

    if [ -e "$target" ]; then
        die "worktree already exists: $target"
        return 1
    fi

    if [ "$existing" -eq 1 ]; then
        validate_existing_branch "$name" || return 1
        run_git worktree add "$target" "$name" || return 1
    else
        run_git worktree add -b "$name" "$target" main || return 1
    fi

    bootstrap_worktree "$name" "$target" || return 1
    write_active_worktree "$name"
}

start_named() {
    local name=$1
    local fresh=${2:-0}
    local path
    path=$(resolve_worktree "$name") || return 1
    start_for_worktree "$name" "$path" || return 1
    if [ "$fresh" -eq 1 ]; then
        run_fresh "$name" "$path" || return 1
    fi
}

start_active() {
    local fresh=${1:-0}
    local name
    name=$(active_worktree_name) || return 1
    start_named "$name" "$fresh"
}

stop_named() {
    local name
    local path
    name=$1
    path=$(resolve_worktree "$name") || return 1
    stop_for_worktree "$name" "$path"
}

stop_active() {
    local name
    name=$(active_worktree_name) || return 1
    stop_named "$name"
}

switch_worktree() {
    local name=$1
    local fresh=${2:-0}
    local target
    target=$(resolve_worktree "$name") || return 1
    if ! start_named "$name" 0; then
        printf 'Start des Worktrees "%s" fehlgeschlagen.\n' "$name" >&2
        return 1
    fi

    if [ "$fresh" -eq 1 ] && ! run_fresh "$name" "$target"; then
        printf 'Ziel-Stack läuft, aber der Datenbank-Reset wurde nicht abgeschlossen.\n' >&2
        return 1
    fi
    write_active_worktree "$name"
}

bootstrap_named() {
    local name=$1
    local target
    target=$(resolve_worktree "$name") || return 1
    bootstrap_worktree "$name" "$target"
}

show_status_for_name() {
    local name=$1
    local path
    local branch
    path=$(resolve_worktree "$name") || return 1
    branch=$(git -C "$path" branch --show-current)
    printf 'active: %s\npath: %s\nbranch: %s\n' "$name" "$path" "$branch"
    if [ ! -f "$(worktree_state_path "$name")" ]; then
        printf 'status: unconfigured\ninitialize: bin/worktree start %s\n' "$name"
        return 0
    fi
    load_worktree_state "$name" || return 1
    printf 'project: %s\nurl: http://127.0.0.1:%s\nports: app=%s vite=%s db=%s redis=%s\n' \
        "$WORKTREE_STATE_COMPOSE_PROJECT_NAME" "$WORKTREE_STATE_APP_PORT" \
        "$WORKTREE_STATE_APP_PORT" "$WORKTREE_STATE_VITE_PORT" \
        "$WORKTREE_STATE_DB_PORT" "$WORKTREE_STATE_REDIS_PORT"
    if stack_is_running_for_worktree "$name" "$path"; then
        printf 'status: running\n'
    else
        printf 'status: stopped\n'
    fi
}

show_status() {
    local name
    name=$(active_worktree_name) || return 1
    if ! resolve_worktree "$name" >/dev/null 2>&1; then
        printf 'stale active worktree: %s\n' "$name" >&2
        return 1
    fi
    show_status_for_name "$name"
}

show_all_status() {
    local path
    local name
    local state_name
    for path in "$worktree_root/.worktrees"/*; do
        [ -d "$path" ] || continue
        name=${path##*/}
        [ "$name" = .state ] && continue
        validate_worktree_name "$name" || continue
        show_status_for_name "$name"
    done
    while IFS= read -r state_name; do
        [ -n "$state_name" ] || continue
        if ! resolve_worktree "$state_name" >/dev/null 2>&1; then
            printf 'orphaned: %s\n' "$state_name"
        fi
    done < <(list_worktree_state_names)
}

if [ "$#" -eq 0 ]; then
    usage >&2
    exit 1
fi

command=$1
shift
case "$command" in
    create)
        if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
            usage >&2
            exit 1
        fi
        case "${2:-}" in
            '') create_worktree "$1" 0 ;;
            --existing) create_worktree "$1" 1 ;;
            *) usage >&2; exit 1 ;;
        esac
        ;;
    bootstrap)
        if [ "$#" -ne 1 ]; then
            usage >&2
            exit 1
        fi
        bootstrap_named "$1"
        ;;
    switch)
        if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
            usage >&2
            exit 1
        fi
        case "${2:-}" in
            '') switch_worktree "$1" 0 ;;
            --fresh) switch_worktree "$1" 1 ;;
            *) usage >&2; exit 1 ;;
        esac
        ;;
    start)
        if [ "$#" -eq 0 ]; then
            start_active 0
        elif [ "$#" -eq 1 ] && [ "$1" = --fresh ]; then
            start_active 1
        elif [ "$#" -eq 1 ]; then
            start_named "$1" 0
        elif [ "$#" -eq 2 ] && [ "$2" = --fresh ]; then
            start_named "$1" 1
        else
            usage >&2
            exit 1
        fi
        ;;
    stop)
        if [ "$#" -eq 0 ]; then
            stop_active
        elif [ "$#" -eq 1 ]; then
            stop_named "$1"
        else
            usage >&2
            exit 1
        fi
        ;;
    status)
        if [ "$#" -eq 0 ]; then
            show_status
        elif [ "$#" -eq 1 ] && [ "$1" = --all ]; then
            show_all_status
        elif [ "$#" -eq 1 ]; then
            show_status_for_name "$1"
        else
            usage >&2
            exit 1
        fi
        ;;
    prune)
        if [ "$#" -ne 0 ]; then
            usage >&2
            exit 1
        fi
        prune_worktree_state
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
